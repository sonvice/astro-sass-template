---
interface Props {
  text?: string;
  variant?: string;
  size?: string;
  class?: string;
  id?: string;
}
const { text, variant, size, class: className, id } = Astro.props;
---
<button id={id} class={`btn ${className ?? ''}`} data-variant={variant} data-size={size}>
  <slot name="icon-left"/>
  {text}
  <slot name="icon-right"/>
</button>
