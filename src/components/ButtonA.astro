---
interface Props {
  text?: string;
  variant?: string;
  size?: string;
  href?: string;
  class?: string;
  id?: string;
}
const { text, variant, size, href = "#", class: className, id } = Astro.props;
---
<a href={href} id={id} class={`btn ${className ?? ''}`} data-variant={variant} data-size={size}>
  <slot name="icon-left"/>
  {text}
  <slot name="icon-right"/>
</a>
